# ---- Server ----
PORT=3000
HOST=0.0.0.0
# Random 32+ char string. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Public URL used in Slack/webhook alert links
PUBLIC_URL=http://localhost:3000

# ---- Storage (MySQL) ----
DATABASE_URL=mysql://bmv:bmv@localhost:3306/bmv

# ---- Edition ----
# Leave empty for the free edition. Paste your Pro key to unlock alerts, users, folders and flows.
BMV_LICENSE_KEY=
# Where the "Unlock Pro" button sends people
BMV_CHECKOUT_URL=https://bullmq-visualizer.dev/pro

# ---- Safety ----
# BMV_READ_ONLY=true refuses every write (add/retry/remove/pause/clean/drain, and all
# connection/user/alert/folder/license changes) with HTTP 423. Reads are untouched.
# Use it the first time you point the dashboard at a production Redis.
BMV_READ_ONLY=false

# ---- Demo / playground ----
# DEMO_MODE=true auto-creates an admin, seeds a connection to DEMO_REDIS_URL,
# unlocks Pro with a "demo" badge and blocks destructive settings changes.
DEMO_MODE=false
DEMO_REDIS_URL=redis://localhost:6379
DEMO_ADMIN_EMAIL=demo@bullmq-visualizer.dev
DEMO_ADMIN_PASSWORD=demo1234

# ---- Performance knobs (defaults are safe) ----
# Seconds the discovered queue list is cached per connection
BMV_QUEUE_DISCOVERY_TTL=30
# Seconds between alert evaluations
BMV_ALERTS_INTERVAL=15
# Max bytes of job `data` returned in list views (full data on the job page)
BMV_JOB_PREVIEW_BYTES=2048
