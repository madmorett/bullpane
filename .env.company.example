# ---------------------------------------------------------------------------
# Bullpane — company trial config.  cp .env.company.example .env
# ---------------------------------------------------------------------------

# REQUIRED. Signs session cookies. Generate once and keep it:
#   openssl rand -hex 32
SESSION_SECRET=

# The URL people will use. Alert links point here.
PUBLIC_URL=http://localhost:3000
PORT=3000

# --- Where the DASHBOARD stores its own data (users, connections, alerts) ----
# Option A (default): leave this commented out and the bundled MySQL is used.
# Option B: point at your RDS and start with `--profile external-db`.
#   The user needs CREATE TABLE on this database; the schema builds itself.
# DATABASE_URL=mysql://bullpane:password@your-instance.eu-west-1.rds.amazonaws.com:3306/bullpane

# Password for the bundled MySQL (Option A only). Change it for anything
# longer-lived than a trial.
# MYSQL_PASSWORD=bullpane
# MYSQL_ROOT_PASSWORD=root

# --- Pro ---------------------------------------------------------------------
# Unlocks alerts, users & roles, folders. Can also be pasted in Settings → License.
BULLPANE_LICENSE_KEY=

# --- Safety ------------------------------------------------------------------
# true = refuse every write (add/retry/remove/pause/clean/drain and all settings
# changes) with HTTP 423. Start here when pointing at production.
BULLPANE_READ_ONLY=true

# --- Performance (defaults are safe) -----------------------------------------
# Seconds the discovered queue list is cached per connection
BULLPANE_QUEUE_DISCOVERY_TTL=30
# Bytes of job `data` returned in list views (full data still on the job page)
BULLPANE_JOB_PREVIEW_BYTES=2048
# Seconds between alert evaluations
BULLPANE_ALERTS_INTERVAL=15
# Audit log retention in days (Pro). 365 = one year; 0 = keep forever.
BULLPANE_AUDIT_RETENTION_DAYS=365
LOG_LEVEL=info
