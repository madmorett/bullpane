{
  "family": "bullmq-visualizer",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<TASK_ROLE>",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/<EXECUTION_ROLE>",
  "containerDefinitions": [
    {
      "name": "bullmq-visualizer",
      "image": "<REGISTRY>/bullmq-visualizer:<VERSION>",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp",
          "name": "http"
        }
      ],
      "environment": [
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "PUBLIC_URL",
          "value": "https://queues.example.com"
        },
        {
          "name": "BMV_READ_ONLY",
          "value": "true"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "BMV_QUEUE_DISCOVERY_TTL",
          "value": "30"
        },
        {
          "name": "BMV_JOB_PREVIEW_BYTES",
          "value": "2048"
        },
        {
          "name": "BMV_ALERTS_INTERVAL",
          "value": "15"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:bullmq-visualizer/database-url"
        },
        {
          "name": "SESSION_SECRET",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:bullmq-visualizer/session-secret"
        },
        {
          "name": "BMV_LICENSE_KEY",
          "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:bullmq-visualizer/license-key"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:3000/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/bullmq-visualizer",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "stopTimeout": 30
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "tags": []
}